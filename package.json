    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "element-plus": "^2.14.5",
    "ffmpeg-static": "^5.3.0",
    "lucide-vue-next": "^0.577.0"
  }
}
