{
  "name": "tesla-dashcam",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Tesla dashcam footage viewer and export desktop application.",
  "author": "autumn <16638808906@163.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "tesla",
    "dashcam",
    "vite",
    "vue"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:test": "npm run typecheck && vite build --mode test && electron-builder",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
